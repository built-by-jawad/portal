DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Base URL this app is served from — used to build the Google OAuth redirect URI and the
# tracking-pixel URL embedded in sent emails. Must be publicly reachable for tracking to work
# (localhost is fine for OAuth/send during local dev, but Gmail can't reach a localhost pixel).
APP_URL="http://localhost:3000"

# From Google Cloud Console (project "builtbyjawad-portal") → APIs & Services → Credentials.
# Redirect URI registered on the OAuth client must be "$APP_URL/api/google/callback".
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"

# From Vercel dashboard → Storage → Blob (create a store, then Connect to this project).
# Auto-injected on Vercel; needed locally too if you want to test attachment uploads from your machine.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# Auto-provided by Vercel on every deployment once a Protection Bypass secret is added under
# Project Settings → Deployment Protection → Protection Bypass for Automation. Needed so Gmail's
# image proxy (fetching the tracking pixel) isn't blocked by Vercel's deployment protection wall.
# Not set locally — irrelevant since a localhost pixel URL isn't reachable from Gmail anyway.
# VERCEL_AUTOMATION_BYPASS_SECRET is intentionally not listed here as a value to set.
