generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// LeadStatus (string): NEW | RESEARCHED | CONTACTED | REPLIED | BOOKED | DEAD
// Trade (string): PLUMBING | ROOFING | REMODELING | GENERAL_CONTRACTING | OTHER
// Kept as plain strings (not Postgres enums) and validated in app code (see src/lib/constants.ts) — this schema
// started on SQLite (no enum support) and there was no reason to churn it when moving to Postgres.

model Lead {
  id           String   @id @default(cuid())
  businessName String
  contactName  String?
  email        String?
  phone        String?
  website      String?
  address      String?
  trade        String   @default("OTHER")
  status       String   @default("NEW")
  leakNotes    String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emails EmailStepRecord[]
}

// One row per email in a lead's sequence (order 0 = initial email, 1+ = follow-ups).
// Follow-ups can be added/removed freely, from the Add Lead form or later from the lead detail page — there's no fixed cap.
// scheduledDate/Time/Timezone are the planned send time, entered by hand (not computed) — kept as plain strings
// rather than a converted UTC instant so what's displayed is always exactly what was typed.
model EmailStepRecord {
  id                String    @id @default(cuid())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  order             Int
  subject           String
  body              String
  scheduledDate     String?
  scheduledTime     String?
  scheduledTimezone String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([leadId, order])
}
