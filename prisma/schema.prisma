generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// LeadStatus (string): NEW | RESEARCHED | CONTACTED | REPLIED | BOOKED | DEAD
// Trade (string): PLUMBING | ROOFING | REMODELING | GENERAL_CONTRACTING | OTHER
// Kept as plain strings (not Postgres enums) and validated in app code (see src/lib/constants.ts) — this schema
// started on SQLite (no enum support) and there was no reason to churn it when moving to Postgres.

model Lead {
  id                String    @id @default(cuid())
  businessName      String
  contactName       String?
  email             String?
  // Extra email addresses for this lead beyond the primary `email` (e.g. a second contact) —
  // reference/display only, sending and inbox scoping still use the primary `email` field.
  secondaryEmails   String[]  @default([])
  phone             String?
  website           String?
  address           String?
  trade             String    @default("OTHER")
  status            String    @default("NEW")
  leakNotes         String?
  notes             String?
  // Outreach tracker fields (owner name lives in contactName). `status` above is the legacy status,
  // kept in sync from outreachStatus (see src/lib/outreach.ts) so older code keeps working.
  city              String?
  state             String?
  instagram         String?
  facebook          String?
  linkedin          String?
  channels          String[]  @default([])
  outreachStatus    String    @default("NEW")
  stopReason        String?
  sequenceDone      Boolean   @default(false)
  contactedAt       DateTime?
  repliedAt         DateTime?
  callBookedAt      DateTime?
  teardownSentAt    DateTime?
  wonAt             DateTime?
  // IANA timezone (e.g. "America/Chicago"), auto-filled from `state` via src/lib/timezone.ts when a
  // sequence starts, editable by hand. Drives the 8:30-10:30am local send window for automated sends.
  timezone          String?
  // Which Titan mailbox sends this lead's sequence. Assigned automatically (least-loaded active
  // mailbox) when the sequence starts, reassignable by hand at any time.
  mailboxId         String?
  mailbox           Mailbox?  @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  // Set when "Start sequence" is run — the anchor date the day 1/4/7/10/13 cadence is computed from.
  sequenceStartedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sequences          OutreachSequence[]
  emails             EmailStepRecord[]
  engagementProfiles EngagementProfile[]
  tasks              Task[]
  files              LeadFile[]
  clientUpdates      ClientUpdate[]
  questions          ClientQuestion[]
}

// A Titan mailbox used to actually send outreach sequences via n8n. SMTP/IMAP credentials are NOT
// stored here — they live only in n8n's own credential store, one set per mailbox's dedicated
// workflow. This table exists purely so the portal can assign leads to a mailbox and track load.
model Mailbox {
  id        String   @id @default(cuid())
  label     String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // "TITAN" mailboxes send via SMTP using a password in TITAN_MAILBOX_PASSWORDS (src/lib/mailSend.ts).
  // "GMAIL" mailboxes send via the Gmail API using the OAuth tokens below, obtained through
  // Google sign-in at /settings (src/app/api/auth/google/*).
  provider     String    @default("TITAN")
  refreshToken String?
  accessToken  String?
  tokenExpiry  DateTime?

  leads      Lead[]
  sentSteps  EmailStepRecord[] @relation("SentFromMailbox")
  messages   MailMessage[]
  syncStates MailSyncState[]
}

// One synced copy of a real IMAP message, across any folder, for the full mail client at /mail.
// Populated by src/lib/mailSync.ts (polled by n8n hitting /api/n8n/mail/sync) — this table is a
// cache of what's on the IMAP server, not a source of truth; re-syncing just upserts on
// [mailboxId, folder, uid]. threadKey groups a conversation (normalized subject + the other
// party's address) since Titan mail doesn't reliably carry References headers to thread on.
model MailMessage {
  id          String   @id @default(cuid())
  mailboxId   String
  mailbox     Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  folder      String
  uid         Int
  messageId   String?
  inReplyTo   String?
  threadKey   String
  fromAddress String
  fromName    String?
  toAddress   String?
  subject     String
  textPlain   String?
  textHtml    String?
  date        DateTime
  seen        Boolean  @default(false)
  flagged     Boolean  @default(false)
  // Set when this row was created by a send/reply from the portal itself (vs. picked up by sync),
  // so the UI doesn't need to wait for the next sync to show a just-sent message.
  sentByPortal Boolean @default(false)
  createdAt   DateTime @default(now())

  attachments MailAttachment[]

  @@unique([mailboxId, folder, uid])
  @@index([mailboxId, threadKey])
}

// A file attachment on a synced MailMessage, stored in the same Vercel Blob store as everything
// else (mail-attachments/ prefix). Populated during sync in src/lib/mailSync.ts.
model MailAttachment {
  id            String      @id @default(cuid())
  mailMessageId String
  mailMessage   MailMessage @relation(fields: [mailMessageId], references: [id], onDelete: Cascade)
  filename      String
  contentType   String
  size          Int
  url           String
  createdAt     DateTime    @default(now())
}

// Tracks the highest UID already synced per mailbox+folder, so each sync only fetches what's new.
model MailSyncState {
  id        String   @id @default(cuid())
  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  folder    String
  lastUid   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([mailboxId, folder])
}

// Files (screenshots, PDFs, etc.) attached directly to a lead, separate from email attachments —
// stored in the same Vercel Blob store under a leads/ prefix.
model LeadFile {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  filename    String
  url         String
  size        Int
  contentType String
  createdAt   DateTime @default(now())
}

// One social profile being warmed up: a business name plus one platform's profile URL, either
// added by hand on the Engagement page or imported from an outreach Lead's active channel (leadId
// set in that case, so it's traceable back to the lead). Creating one seeds a 7-day EngagementDay
// checklist for it, each day with a fixed action (see ENGAGEMENT_DAY_ACTIONS in src/lib/constants.ts).
model EngagementProfile {
  id           String   @id @default(cuid())
  businessName String
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  platform     String
  profileUrl   String
  // Preferred time of day to do the engagement, e.g. "09:00" — shown on every day card, optional.
  time         String?
  createdAt    DateTime @default(now())

  days EngagementDay[]

  @@index([leadId])
}

// One day (1..7) of an EngagementProfile's warm-up checklist. `date` is the calendar day this
// check-in is planned for; `completedAt` is set when it's actually done. Shown as its own card on
// the Engagement page (one card per profile per day).
model EngagementDay {
  id          String            @id @default(cuid())
  profileId   String
  profile     EngagementProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayNumber   Int
  date        String
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  @@unique([profileId, dayNumber])
}

// One row per email in a lead's sequence (order 0 = initial email, 1+ = follow-ups).
// Follow-ups can be added/removed freely, from the Add Lead form or later from the lead detail page — there's no fixed cap.
// scheduledDate/Time are the planned send date/time, entered by hand, shown on the calendar and in the due-items
// digest — purely a reference plan, nothing in the portal actually sends on this schedule. scheduledTimezone is
// auto-guessed server-side from the lead's address (see src/lib/timezone.ts) whenever left blank, but can be
// overridden by hand. All three are kept as plain strings rather than a converted UTC instant so what's displayed
// is always exactly what was set.
// hasSubject lets a follow-up skip the subject line entirely.
// status/sentAt/sentFromMailboxId/claimedAt/messageId track real automated sending via n8n:
// status: PENDING (not sent/due yet) | QUEUED (claimed by an n8n poll, awaiting send confirmation —
// treated as stale and re-claimable after ~10 min) | SENT | SKIPPED (sequence stopped before this
// step ran) | FAILED (send attempt errored, retryable by hand).
model EmailStepRecord {
  id                String    @id @default(cuid())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  order             Int
  hasSubject        Boolean   @default(true)
  subject           String
  body              String
  scheduledDate     String?
  scheduledTime     String?
  scheduledTimezone String?
  status            String    @default("PENDING")
  sentAt            DateTime?
  sentFromMailboxId String?
  sentFromMailbox   Mailbox?  @relation("SentFromMailbox", fields: [sentFromMailboxId], references: [id], onDelete: SetNull)
  claimedAt         DateTime?
  messageId         String?
  // Gmail's own thread id (only set for Gmail-provider mailboxes). Passed back into a follow-up's
  // send request so Gmail groups it into the same thread server-side — more reliable than relying
  // on In-Reply-To/References header matching alone.
  threadId          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  attachments Attachment[]

  @@unique([leadId, order])
}

// A file attached to a specific email step, uploaded to Vercel Blob storage. Stored separately from the
// record rather than as a list column so files can be added/removed one at a time.
model Attachment {
  id                String          @id @default(cuid())
  emailStepRecordId String
  emailStepRecord   EmailStepRecord @relation(fields: [emailStepRecordId], references: [id], onDelete: Cascade)
  filename          String
  url               String
  size              Int
  contentType       String
  createdAt         DateTime        @default(now())
}

// A to-do item, optionally tied to a lead ("which client this is for"). dueDate is a plain
// YYYY-MM-DD string like the email scheduling fields, entered by hand, shown on the /tasks
// calendar — date-only, no time of day. completedAt is set when marked done — done tasks stay in
// the Done view, not deleted.
model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  source      String?
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dueDate     String?
  completedAt DateTime?
  media       TaskMedia[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model TaskMedia {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename    String
  url         String
  size        Int
  contentType String
  createdAt   DateTime @default(now())

  @@index([taskId])
}

// A logged unit of work done for a client (a Lead with status BOOKED) — powers the /client-updates
// page's weekly (every Sunday) and monthly (last day of month) client-facing progress reports.
// date is a plain YYYY-MM-DD string, hand-entered, matching the scheduling fields elsewhere in
// this schema.
model ClientUpdate {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  date        String
  taskName    String
  description String?
  // Optional link to proof hosted elsewhere (a live page, a doc, a video) — alongside or instead
  // of uploaded/pasted screenshots, both are optional.
  proofLink   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  screenshots ClientUpdateScreenshot[]
}

// Proof screenshot(s) for one ClientUpdate, uploaded to Vercel Blob (same pattern as
// Attachment/LeadFile) — either picked via file input or pasted straight from the clipboard.
model ClientUpdateScreenshot {
  id             String       @id @default(cuid())
  clientUpdateId String
  clientUpdate   ClientUpdate @relation(fields: [clientUpdateId], references: [id], onDelete: Cascade)
  filename       String
  url            String
  size           Int
  contentType    String
  createdAt      DateTime     @default(now())
}

// A running "things to ask this client" list, shown on their lead detail page — jot a question
// down whenever it comes to mind, check it off (optionally logging the answer) once it's actually
// asked and answered so nothing gets forgotten before the next call/email.
model ClientQuestion {
  id         String                @id @default(cuid())
  leadId     String
  lead       Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  question   String
  answer     String?
  resolvedAt DateTime?
  media      ClientQuestionMedia[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model ClientQuestionMedia {
  id          String         @id @default(cuid())
  questionId  String
  question    ClientQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  filename    String
  url         String
  size        Int
  contentType String
  createdAt   DateTime       @default(now())

  @@index([questionId])
}

// A free-form idea jotted down for later (a niche to try, a feature to build, a content angle,
// anything) — not tied to a lead or client, just a running scratchpad. starred pins it to the top;
// there's no "done" state, delete it once it's no longer worth keeping.
model Idea {
  id        String   @id @default(cuid())
  content   String
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Raw, unqualified business data (usually pulled in bulk from the Google Maps scraper, sometimes
// added by hand) — a spreadsheet/database of businesses that are NOT leads yet. Nothing here has
// been vetted or had outreach started. Pure data storage/qualification tool, no "convert" step.
// customFields holds values for any ad-hoc columns added via ProspectColumn, keyed by column id.
model Prospect {
  id           String   @id @default(cuid())
  businessName String
  phone        String?
  emails       String?
  website      String?
  category     String?
  address      String?
  rating       Float?
  reviewCount  Int?
  notes        String?
  source       String?
  customFields Json     @default("{}")
  order        Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  checklistItems ProspectChecklistItem[]
}

// A user-defined extra column on the Prospects grid (beyond the built-in fields on Prospect
// itself) — Notion-database style. Values live in Prospect.customFields[key]. type is "TEXT" or
// "NUMBER", validated/interpreted in app code.
model ProspectColumn {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  type      String   @default("TEXT")
  createdAt DateTime @default(now())
}

// Singleton row holding the display order of every Prospects grid column (built-in field keys
// plus ProspectColumn ids/keys, mixed together) so built-in and custom columns can be reordered
// against each other. id is always "singleton".
model ProspectBoardSettings {
  id          String   @id @default("singleton")
  columnOrder String[] @default([])
  updatedAt   DateTime @updatedAt
}

// One checklist line under a named section on a prospect's detail panel (e.g. "Independence
// check" -> "Google the business name + franchise..."). New prospects are seeded from the
// default qualification template in src/lib/prospectChecklist.ts, then fully editable per-row
// (add/edit/delete/check) from there — the template is just a starting point, not a schema.
model ProspectChecklistItem {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  section    String
  text       String
  checked    Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

// A stored content script (call script, video/reel script, email script, etc.) — free-text title,
// optional category label, and the script body itself. Shown as a card grid on /scripts; clicking
// a card opens the full script on its own page (/scripts/[id]).
model Script {
  id        String   @id @default(cuid())
  title     String
  category  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per lead per channel (EMAIL / INSTAGRAM / FACEBOOK / LINKEDIN).
model OutreachSequence {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel        String
  startDate      String
  stepIndex      Int       @default(0)
  lastTouchDate  String?
  notes          String?
  nextActionDate String?
  decision       String?
  repliedAt      DateTime?
  done           Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([leadId, channel])
}

// Editable cadence lookup: which day (counted from the start date, day 1 = start date) each step happens.
model CadenceStep {
  id         String  @id @default(cuid())
  channel    String
  position   Int
  day        Int
  label      String  @default("")
  isDecision Boolean @default(false)

  @@unique([channel, position])
}

// After the last step, the sequence repeats every N days.
model CadenceSetting {
  channel     String @id
  repeatEvery Int    @default(30)
}

// role "ADMIN" always has full view+edit on every page and isn't subject to ProfilePermission
// rows; "MEMBER" is gated per page by ProfilePermission (see src/lib/permissions.ts for page keys).
model Profile {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  imageUrl     String?
  role         String   @default("MEMBER")
  createdAt    DateTime @default(now())

  permissions   ProfilePermission[]
  expensesPaid  Expense[]           @relation("ExpensePaidBy")
  expenseShares ExpenseShare[]
}

model ProfilePermission {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  page      String
  canView   Boolean @default(false)
  canEdit   Boolean @default(false)

  @@unique([profileId, page])
}

// splitMode "EQUAL" divides amount evenly across its ExpenseShare rows; "CUSTOM" uses each
// share's own amount as entered. adminOnly expenses carry no shares and are never visible
// to non-admin profiles.
model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        String
  adminOnly   Boolean  @default(false)
  splitMode   String   @default("EQUAL")
  paidById    String?
  paidBy      Profile? @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  shares ExpenseShare[]
}

model ExpenseShare {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  amount    Float

  @@unique([expenseId, profileId])
}
